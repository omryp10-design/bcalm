<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvDailySummaryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daily Summary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvTotalFeedings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Feedings: 0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvTotalMilk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Milk: 0 ml"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvAverageFeeding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Average Feeding: 0 ml"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Baby Intake Comparison"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvBabyAge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Baby Age: --"
        android:textSize="16sp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvExpectedDailyIntake"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Expected Daily Intake: --"
        android:textSize="16sp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvIntakeComparison"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Comparison: --"
        android:textSize="16sp"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Feeding History"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <ListView
        android:id="@+id/lvFeedings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnAddFeeding"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Add New Feeding"
        android:textSize="18sp"
        android:layout_marginTop="16dp" />

</LinearLayout>