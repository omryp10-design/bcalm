<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pink-to-teal outer ring -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="#E8739A"
                android:centerColor="#5BBFD6"
                android:endColor="#E8739A"
                android:angle="0"/>
        </shape>
    </item>

    <!-- White inner circle -->
    <item
        android:top="7dp"
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp">
        <shape android:shape="oval">
            <solid android:color="#F4F9FD"/>
            <stroke android:width="1dp" android:color="#D6EEF5"/>
        </shape>
    </item>

</layer-list>